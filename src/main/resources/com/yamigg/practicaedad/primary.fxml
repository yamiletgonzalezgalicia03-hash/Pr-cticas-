<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="180.0" prefWidth="380.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.yamigg.practicaedad.PrimaryController">
   <children>
      <Label layoutX="20.0" layoutY="25.0" text="Fecha de nacimiento" />
      <TextField fx:id="txtFecha" layoutX="170.0" layoutY="20.0" prefHeight="25.0" prefWidth="150.0" promptText="dd/mm/aaaa" />
      
      <Button fx:id="btnCalcularedad" text="Calcular" onAction="#btnCalcularEdad"  />
      <Button fx:id="btnLimpiar" text="Limpiar" onAction="#btnLimpiar"  />
      
      <Label fx:id="lblResultado"  text=" " />
   </children>
</VBox>
