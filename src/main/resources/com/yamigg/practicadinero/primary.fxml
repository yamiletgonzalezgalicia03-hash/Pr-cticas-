<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?> 
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.yamigg.practicadinero.PrimaryController">
 <children>
     <HBox spacing="10"><children><Label text="Dinero: " /></children></HBox>
     <HBox spacing="10"><children><TextField fx:id="txtDinero"  promptText="9999"/></children></HBox>
     <HBox spacing="10"><children><Button fx:id="btnLimpiar" text="X"  onAction="#btnLimpiar"/></children></HBox>
     <HBox spacing="10"><children><Button fx:id="btnDesglosar" text="Desglosar" onAction="#btnDesglosar"/></children></HBox>
     <HBox spacing="10"><children><Label text="Billetes $500" /><TextField fx:id="txt500" promptText=" "/></children></HBox>
     <HBox spacing="10"><children><Label text="Billetes $200" /> <TextField fx:id="txt200" promptText=" "/></children></HBox>
     <HBox spacing="10"><children><Label text="Billetes $100" /> <TextField fx:id="txt100" promptText=" "/></children></HBox>
     <HBox spacing="10"><children><Label text="Billetes $50" /><TextField fx:id="txt50" promptText=" "/></children></HBox>
     <HBox spacing="10"><children><Label text="Billetes $20" /><TextField fx:id="txt20" promptText=" "/></children></HBox>
     <HBox spacing="10"><children><Label text="Monedas $10" /><TextField fx:id="txt10" promptText=" "/></children></HBox>
     <HBox spacing="10"><children><Label text="Monedas $5" /><TextField fx:id="txt5" promptText=" "/></children></HBox>
     <HBox spacing="10"><children><Label text="Monedas $2" /> <TextField fx:id="txt2" promptText=" "/></children></HBox>
     <HBox spacing="10"><children><Label text="Monedas $1" /> <TextField fx:id="txt1" promptText=" "/></children></HBox>
 </children>
     <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
      </padding>
</VBox>
